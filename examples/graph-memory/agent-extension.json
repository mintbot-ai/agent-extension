{
  "spec_version": "0.2",
  "kind": "agent-extension",
  "identity": {
    "name": "graph-memory",
    "version": "0.2.0",
    "display_name": "Graph Memory",
    "description": "Temporal knowledge-graph memory (Graphiti on FalkorDB) that replaces flat-file agent memory with a queryable, time-aware graph.",
    "author": "mintbot",
    "license": "MIT",
    "homepage": "https://ext.example.com/graph-memory"
  },
  "provides": {
    "services": [
      { "name": "falkordb", "kind": "daemon", "summary": "FalkorDB graph store", "endpoint": "tcp://127.0.0.1:6379" }
    ],
    "memory": [
      { "name": "graph", "kind": "graph", "summary": "temporal knowledge graph", "schema_ref": "schemas/graph.md" }
    ],
    "tools": [
      { "name": "memory_write", "summary": "add a fact / edge to the graph", "input_schema_ref": "schemas/memory_write.json" },
      { "name": "memory_query", "summary": "graph / temporal query over stored facts", "input_schema_ref": "schemas/memory_query.json" }
    ],
    "skills": [
      { "name": "graph-memory", "summary": "how to store and query graph memory", "path": "skills/graph-memory/" }
    ],
    "cron": [
      { "name": "nightly-compaction", "schedule": "0 4 * * *", "summary": "prune and compact stale edges" }
    ],
    "config": {
      "schema_ref": "schemas/config.schema.json",
      "secrets": ["FALKOR_PASSWORD"]
    }
  },
  "requires": {
    "resources": { "disk_mb": 250, "ram_mb": 200 }
  },
  "permissions": {
    "network_egress": [],
    "filesystem": ["state:rw"],
    "root": true,
    "reason": "runs a local FalkorDB daemon under systemd; no external network egress"
  },
  "release": {
    "channel": "stable",
    "published_at": "2026-07-28T10:00:00Z",
    "valid_until": "2026-08-27T10:00:00Z",
    "changelog": "https://ext.example.com/graph-memory/CHANGELOG.md#0-2-0",
    "artifact": {
      "url": "https://ext.example.com/graph-memory-0.2.0.tar.gz",
      "sha256": "TBD-fill-at-publish-time"
    }
  },
  "updates": {
    "source": { "kind": "github", "repo": "mintbot-ai/graph-memory" },
    "check": "daily",
    "policy": "auto"
  },
  "signing": {
    "public_key": "ed25519:MCowBQYDK2VwAyEAGb9ECWmEzf6FQbrBZ9w7lshQhqowtrbLDFw4rXAxZuE=",
    "key_id": "graph-memory-2026",
    "next_key": null
  },
  "signature": "REPLACE_WITH_BASE64_ED25519_SIGNATURE_OVER_CANONICAL_MANIFEST",
  "targets": [
    {
      "runtime": "hermes",
      "runtime_version": ">= 2026.6",
      "enforcement": "declared",
      "delivery": {
        "method": "hermes-integration",
        "install_url": "https://ext.example.com/graph-memory-hermes.tar.gz",
        "install_sha256": "TBD-fill-at-publish-time",
        "uninstall_command": "/opt/graph-memory/uninstall.sh"
      },
      "lifecycle": {
        "install": "install.sh",
        "upgrade": "upgrade.sh",
        "uninstall": "uninstall.sh",
        "health": "healthcheck.sh"
      },
      "component_map": {
        "skills": "skills/",
        "tools": { "module": "plugins/graph_memory/", "register": "plugins/graph_memory/__init__.py" },
        "services": {
          "unit": "systemd:falkordb-graphmem.service",
          "actions": ["daemon-reload", "enable", "start"],
          "restart": "on-failure",
          "health": "redis-cli -p 6379 ping"
        },
        "cron": { "unit": "systemd:graphmem-compaction.timer", "schedule": "0 4 * * *" }
      }
    }
  ]
}
